---
import Logo from '../components/Logo'
import BaseLayout from '../layouts/BaseLayout.astro'
import SearchBar from '../components/SearchBar'
---

<BaseLayout
  title="fabrica — The Parts Library for Everything Robotics."
  description="fabrica is an online robotics parts library."
>
  <header class="fixed w-full">
    <noscript
      class="w-full bg-fb-secondary-dark dark:bg-fb-secondary-light flex items-center justify-center"
    >
      <p
        class="text-fb-text-primary-light dark:text-fb-text-primary-dark px-2 text-center"
      >
        JavaScript was detected as disabled. Please enable JavaScript for
        increased functionality like search-as-you-type.
      </p>
    </noscript>
    {/* nav stuff */}
  </header>
  <main>
    <section
      aria-label="Parts search"
      class="flex items-center justify-center h-svh"
    >
      <div class="flex flex-col max-w-200 w-3/4 items-center gap-6 pb-[10%]">
        <Logo coerceToSmall={false} />
        <SearchBar
          interactivity={null}
          placeholder="Search for parts..."
          client:load
        />
      </div>
    </section>
  </main>
</BaseLayout>
